# OS files
.DS_Store
Thumbs.db

# Editor and assistant configuration (machine-specific, local only)
/.vscode/
/.claude/

# R files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto cache
/.quarto/
**/*.quarto_ipynb
notebooks/*.out.ipynb

# LaTeX intermediate files (keep only final outputs)
index.log
index.aux
index.out
index.bbl
index.blg

# Python cache
__pycache__/
*.pyc

# Virtual environment (managed by uv)
.venv/

# Old output directories (no longer used)
_manuscript/
index-meca.zip

# Private working material -- kept locally, never published.
# log/     session logs, some naming authors, affiliations and grant numbers
# docs/    cover letters, referee reports, the response report
# legacy/  frozen submission bundles, including non-blind cover letters
/log/
/docs/
/legacy/

# REGION extension format-resources (auto-copied to root during render).
# Anchored with / so they only match at the repo root — legitimate copies
# inside legacy/ submission bundles should still be tracked.
/region.sty
/region.bst
/ERSA_logo.png
/CC-BY-88x31.png

# Stata notebook build artifacts
notebooks/c04_spillover_modeling.log
notebooks/c04_spillover_modeling_table.md

# Keep compiled outputs for transparency:
# index.html
# index.pdf
# index.docx
# site_libs/
# index_files/
# images/
# notebooks/
